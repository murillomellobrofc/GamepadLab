{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GamepadLab",
  "version": "0.1.0",
  "identifier": "io.github.gamepadlab",
  "build": {
    "beforeDevCommand": "npm run dev -w @gamepadlab/ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @gamepadlab/ui",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GamepadLab",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "msi"],
    "category": "Utility",
    "shortDescription": "Teste e calibração de controles",
    "longDescription": "GamepadLab testa e calibra controles (Xbox, DualShock 4, DualSense, Switch Pro e genéricos): botões, analógicos, gatilhos, vibração, giroscópio, touchpad, latência, circularidade, deadzone e curvas. 100% local, sem telemetria.",
    "copyright": "MIT License",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-gamepadlab.rules": "../packaging/linux/70-gamepadlab.rules"
        }
      }
    },
    "windows": {
      "wix": {
        "language": ["pt-BR", "en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/murillomello/gamepadlab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
